# MET SCMS Backend Environment Configuration
# Copy this file to .env and configure

# Server
PORT=5000
NODE_ENV=development

# Demo Mode — enables demo login panel, demo clock, and guided tour
DEMO_MODE=true

# Authentication
JWT_SECRET=change-this-to-a-random-64-char-secret-in-production
SESSION_HOURS=8

# Google Sign-In (optional)
# See README for setup instructions
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# ALLOWED_EMAIL_DOMAIN=met.edu

# SMTP (optional — for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=MET SCMS <noreply@met.edu>
