# ─── MET SCMS Backend (Java) — Environment Variables ───
# Copy this file to .env and fill in production values.
# NEVER commit real secrets to version control.

# Server port (deployment platforms like Railway/Render set this automatically)
PORT=5000

# CORS: comma-separated list of allowed frontend origins
# Example: https://scms.met.edu,https://www.met.edu
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5500

# Path to the frontend static files directory (relative or absolute)
FRONTEND_PATH=../frontend/

# Path to the JSON database file
DB_FILE_PATH=data/db.json

# Logging level: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
